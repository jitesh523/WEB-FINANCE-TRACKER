# Copy to .env.local for local development.
# In production, set these as Environment Variables in the Vercel dashboard instead.

# Neon (or any Postgres) connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used by better-auth to sign sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the app (used by better-auth for cookies/redirects).
BETTER_AUTH_URL=http://localhost:3000

# Groq API key — console.groq.com. SECRET, server-only.
GROQ_API_KEY=
